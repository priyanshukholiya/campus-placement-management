# Normalise text files to LF in the repository; check out with platform line endings
# unless a file needs a fixed ending to work.
* text=auto

# Shell scripts must keep LF or they fail on Linux/macOS and inside containers.
mvnw      text eol=lf
*.sh      text eol=lf
Dockerfile text eol=lf
*.conf    text eol=lf

# Windows-only launchers.
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files.
*.jar     binary
*.png     binary
*.ico     binary
